{
  "name": "@gain-saas/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "dev:db": "tsx src/scripts/dev-postgres.ts",
    "bootstrap:backfill": "tsx src/scripts/backfill-workspaces.ts",
    "bootstrap:operator": "tsx src/scripts/bootstrap-operator.ts"
  },
  "dependencies": {
    "@gain-saas/engine-client": "workspace:*",
    "@gain-saas/ops-pg": "workspace:*",
    "@gain-saas/shared": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^5.0.1",
    "@prisma/client": "^6.16.0",
    "@temporalio/client": "^1.24.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.1",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "^6.16.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
