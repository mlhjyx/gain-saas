// gain-saas 自有库(技术方案 §4)。与引擎库物理隔离:独立容器、独立角色、独立卷。
// 命名沿用引擎习惯(snake_case)。个人数据红线(SD5):仅 event_inbox 及其派生表
// 可能含个人数据(事件 envelope),按含个人数据存储管理,DSR 级联删除。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 租户用户。密码 argon2id;会话走 session 表 + 短 TTL JWT(PRD §2.3)。
model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  status       String       @default("active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  memberships Membership[]
  // 会话按 session.subjectType/subjectId 松引用(多态),不建 FK 关系

  @@map("users")
}

/// 工作空间。id = 引擎租户 id(签发引擎 token 的 workspace claim)。
enum WorkspaceStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

model Workspace {
  id        String   @id @db.Uuid
  name      String
  /// 注册引导完成时间(SD11):新注册空间为 NULL,前端强制进入引导向导;
  /// 存量空间在迁移中回填为迁移时刻,不打断既有用户。
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  /// 引导建档得到的引擎 CompanyProfile id(只存引用,事实仍在引擎 CompanyProfile)。
  onboardingCompanyId   String?   @map("onboarding_company_id") @db.Uuid
  /// 生命周期状态：ACTIVE 正常 / DISABLED 停用（可恢复）/ ARCHIVED 归档（仅运营可还原）。
  status          WorkspaceStatus @default(ACTIVE)
  statusUpdatedAt DateTime?       @map("status_updated_at")
  statusUpdatedBy String?         @map("status_updated_by")
  statusNote      String?         @map("status_note")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  registry    WorkspaceRegistry?
  invitations Invitation[]
  runLinks    DiscoveryRunLink[]
  complianceDeclarations WorkspaceComplianceDeclaration[]
  budgetPolicy WorkspaceBudgetPolicy?
  tasks       AcquisitionTask[]
  taskRuns    TaskRun[]
  campaigns   Campaign[]
  outreachConsents         OutreachConsent[]
  outreachUnsubscribeTokens OutreachUnsubscribeToken[]
  outreachBatches          OutreachBatch[]
  outreachDrafts           OutreachDraft[]
  outreachBatchApprovals   OutreachBatchApproval[]
  outreachBatchEvents      OutreachBatchEvent[]
  outreachSends            OutreachSend[]
  outreachAuditPackages    OutreachAuditPackage[]
  outreachReplies          OutreachReply[]
  qgos        Qgo[]
  saos        Sao[]
  opportunityOutcomes OpportunityOutcome[]

  @@map("workspace")
}

// ─── M2.0 Campaign 控制面（docs/technical/campaign-control-plane-m2-0.md · ADR-0001） ───
// Campaign / Revision / Audience / Approval / ExecutionAuthorization / DecisionTrace
// 归 gain-saas（Growth Core）所有；Grant 管钱、ExecutionAuthorization 管动作边界。

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CampaignRevisionState {
  DRAFT
  SUBMITTED
  APPROVED
  DECLINED
  EXPIRED
  SUPERSEDED
}

enum CampaignApprovalState {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
}

enum CampaignAuthorizationState {
  ISSUED
  CONSUMED
  EXPIRED
  REVOKED
}

/// M2.1：受限 Campaign 规划 job 的状态机（PENDING → RUNNING → SUCCEEDED | FAILED）。
enum CampaignPlanJobState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  /// M2.2：重规划轮次/成本预算耗尽仍不合法——停在列表等人工编辑 plan JSON。
  NEEDS_HUMAN
}

model Campaign {
  id                String         @id @default(uuid()) @db.Uuid
  workspaceId       String         @map("workspace_id") @db.Uuid
  name              String
  objective         String
  status            CampaignStatus @default(DRAFT)
  /// 指向最新 revision；应用层校验（避免与 revision 循环外键）。
  currentRevisionId String?        @map("current_revision_id") @db.Uuid
  createdBy         String         @map("created_by")
  updatedBy         String         @map("updated_by")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  revisions CampaignRevision[]
  planJobs  CampaignPlanJob[]

  @@index([workspaceId, status])
  @@map("campaign")
}

/// M2.1：一次受限 Campaign 规划 job（异步：BFF 触发 → 引擎工作流 → 内部回调落 DRAFT revision）。
/// 同一 campaign 同时只允许一个活跃 job（部分唯一索引，见迁移）。
model CampaignPlanJob {
  id           String               @id @default(uuid()) @db.Uuid
  workspaceId  String               @map("workspace_id") @db.Uuid
  campaignId   String               @map("campaign_id") @db.Uuid
  state        CampaignPlanJobState @default(PENDING)
  objective    String
  icpId        String?              @map("icp_id") @db.Uuid
  /// 引擎工作流标识（campaign-plan-<jobId>），仅供诊断。
  engineRunRef String?              @map("engine_run_ref")
  /// 成功回调落下 revision 后回填；幂等键 (jobId, planHash)。
  planHash     String?              @map("plan_hash")
  revisionId   String?              @map("revision_id") @db.Uuid
  /// M2.2：逐轮重规划历史（[{round, reasonCode, issues?}]，交付/终态时由引擎回传）。
  replanHistory Json?               @map("replan_history")
  /// M2.2：本 job 由哪个人工拒绝后的自动重生成创建（为空 = 原始规划或人工触发）。
  replanOfJobId String?             @map("replan_of_job_id") @db.Uuid
  error        String?
  issues       Json?
  createdBy    String               @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([workspaceId, campaignId])
  @@index([workspaceId, state])
  @@map("campaign_plan_job")
}

/// 不可变计划版本：任何修改 = 新 revision；审批与授权都绑定 planHash。
model CampaignRevision {
  id          String                @id @default(uuid()) @db.Uuid
  workspaceId String                @map("workspace_id") @db.Uuid
  campaignId  String                @map("campaign_id") @db.Uuid
  revisionNo  Int                   @map("revision_no")
  plan        Json
  planHash    String                @map("plan_hash")
  state       CampaignRevisionState @default(DRAFT)
  createdBy   String                @map("created_by")
  createdAt   DateTime              @default(now()) @map("created_at")

  campaign  Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  audience  CampaignAudience?
  approvals CampaignApproval[]

  @@unique([campaignId, revisionNo])
  @@index([workspaceId, planHash])
  @@index([workspaceId, state])
  @@map("campaign_revision")
}

/// 受众规范化引用（明细在 plan JSON；此表供查询与后续规划器复用）。
model CampaignAudience {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  revisionId     String   @unique @map("revision_id") @db.Uuid
  icpIds         Json     @map("icp_ids")
  includeFilters Json?    @map("include_filters")
  excludeFilters Json?    @map("exclude_filters")
  sizeCap        Int      @map("size_cap")
  createdAt      DateTime @default(now()) @map("created_at")

  revision CampaignRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("campaign_audience")
}

/// 审批状态机：PENDING → APPROVED | DECLINED | EXPIRED（超时=拒绝，decide/读取时惰性投影）。
model CampaignApproval {
  id             String                @id @default(uuid()) @db.Uuid
  workspaceId    String                @map("workspace_id") @db.Uuid
  revisionId     String                @map("revision_id") @db.Uuid
  planHash       String                @map("plan_hash")
  state          CampaignApprovalState @default(PENDING)
  requestedBy    String                @map("requested_by")
  decidedBy      String?               @map("decided_by")
  decidedAt      DateTime?             @map("decided_at")
  decisionReason String?               @map("decision_reason")
  expiresAt      DateTime              @map("expires_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  revision CampaignRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, state])
  @@index([revisionId])
  @@map("campaign_approval")
}

/// 动作边界授权（双钥匙之一）：绑定 planHash + 动作范围 + 短 TTL + 有限次数。
model CampaignExecutionAuthorization {
  id           String                     @id @default(uuid()) @db.Uuid
  workspaceId  String                     @map("workspace_id") @db.Uuid
  campaignId   String                     @map("campaign_id") @db.Uuid
  revisionId   String                     @map("revision_id") @db.Uuid
  planHash     String                     @map("plan_hash")
  scope        Json
  token        String
  state        CampaignAuthorizationState @default(ISSUED)
  maxUses      Int                        @default(1) @map("max_uses")
  uses         Int                        @default(0)
  issuedAt     DateTime                   @default(now()) @map("issued_at")
  expiresAt    DateTime                   @map("expires_at")
  revokedAt    DateTime?                  @map("revoked_at")
  revokeReason String?                    @map("revoke_reason")
  createdAt    DateTime                   @default(now()) @map("created_at")

  @@index([workspaceId, state])
  @@index([campaignId])
  @@map("campaign_execution_authorization")
}

/// 决策轨迹（append-only，D-MA-8 / F2 字段组）：只 INSERT，无更新/删除 API。
model CampaignDecisionTrace {
  id                    String   @id @default(uuid()) @db.Uuid
  workspaceId           String   @map("workspace_id") @db.Uuid
  campaignId            String?  @map("campaign_id") @db.Uuid
  revisionId            String?  @map("revision_id") @db.Uuid
  traceId               String   @map("trace_id")
  parentTraceId         String?  @map("parent_trace_id")
  stepType              String   @map("step_type")
  actor                 String
  actorType             String   @map("actor_type")
  workflow              String?
  workflowVersion       String?  @map("workflow_version")
  attempt               Int      @default(1)
  decisionType          String   @map("decision_type")
  gate                  String?
  policyVersion         String?  @map("policy_version")
  chosenOption          String?  @map("chosen_option")
  score                 Float?
  reasonCode            String?  @map("reason_code")
  evidence              Json?
  rejectedCandidates    Json?    @map("rejected_candidates")
  costEstimatedMicros   BigInt?  @map("cost_estimated_micros")
  costActualMicros      BigInt?  @map("cost_actual_micros")
  budgetDomain          String?  @map("budget_domain")
  budgetRemainingMicros BigInt?  @map("budget_remaining_micros")
  approvalState         String?  @map("approval_state")
  approvalId            String?  @map("approval_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([workspaceId, campaignId])
  @@index([traceId])
  @@map("campaign_decision_trace")
}

// ─── M2 步 11 受控邮件触达：11-1 合规底座 ───────────────────────────────────

enum OutreachConsentStatus {
  OPT_IN
  OPT_OUT
  UNKNOWN
}

/// 外联同意台账（append-only）：每次声明/撤回追加一行；检索取最新，OPT_OUT 永久压制。
model OutreachConsent {
  id          String                @id @default(uuid()) @db.Uuid
  workspaceId String                @map("workspace_id") @db.Uuid
  contactRef  String                @map("contact_ref") @db.Uuid
  channel     String                @default("email") @db.VarChar(16)
  status      OutreachConsentStatus
  source      String                @db.VarChar(64)
  lawfulBasis String                @map("lawful_basis") @db.VarChar(64)
  evidence    Json?
  createdAt   DateTime              @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, contactRef, channel, createdAt])
  @@map("outreach_consent")
}

/// 退订 token（公共端点一次性使用；只存 SHA-256，复用按幂等成功处理）。
model OutreachUnsubscribeToken {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  contactRef  String    @map("contact_ref") @db.Uuid
  /// 退订时同步平台级抑制所需；11-1 签发的旧 token 为 NULL（只做租户内退订）。
  recipientEmail String? @map("recipient_email") @db.VarChar(320)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, contactRef])
  @@map("outreach_unsubscribe_token")
}

// ─── M2 步 11-2：触达批次与草稿审批 ─────────────────────────────────────────

enum OutreachBatchStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DECLINED
  EXPIRED
  QUEUED
  SENT
  /// 全部草稿进入终态（已发送或已跳过），但并非全部发送成功。
  COMPLETED
  CANCELLED
}

enum OutreachDraftStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SKIPPED
  SENT
  FAILED
}

enum OutreachBatchApprovalState {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
}

/// 触达批次：草稿集提交审批；批准后进入待发队列（发送开关默认关，11-3 执行器消费）。
model OutreachBatch {
  id           String              @id @default(uuid()) @db.Uuid
  workspaceId  String              @map("workspace_id") @db.Uuid
  campaignId   String?             @map("campaign_id") @db.Uuid
  /// 绑定的 Campaign ExecutionAuthorization（P4-03：无有效授权不发；由签发方写入，执行器只读消费）。
  authorizationId String?          @map("authorization_id") @db.Uuid
  name         String              @db.VarChar(200)
  status       OutreachBatchStatus @default(DRAFT)
  contentHash  String?             @map("content_hash") @db.Char(64)
  createdBy    String              @map("created_by") @db.VarChar(256)
  submittedAt  DateTime?           @map("submitted_at")
  decidedAt    DateTime?           @map("decided_at")
  queuedAt     DateTime?           @map("queued_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  drafts    OutreachDraft[]
  approvals OutreachBatchApproval[]
  events    OutreachBatchEvent[]
  sends     OutreachSend[]
  auditPackages OutreachAuditPackage[]

  @@index([workspaceId, status])
  @@index([workspaceId, campaignId])
  @@map("outreach_batch")
}

/// 单封草稿：提交后内容冻结；范围变化需重新打开批次并重新审批。
model OutreachDraft {
  id              String              @id @default(uuid()) @db.Uuid
  workspaceId     String              @map("workspace_id") @db.Uuid
  batchId         String              @map("batch_id") @db.Uuid
  contactRef      String              @map("contact_ref") @db.Uuid
  recipientEmail  String              @map("recipient_email") @db.VarChar(320)
  /// 收件人国家（ISO 3166-1 alpha-2，P4-01）；缺失/未知按 REVIEW_REQUIRED fail-closed。
  countryCode     String?             @map("country_code") @db.Char(2)
  companyName     String?             @map("company_name") @db.VarChar(200)
  subject         String              @db.VarChar(300)
  body            String
  status          OutreachDraftStatus @default(DRAFT)
  contentHash     String?             @map("content_hash") @db.Char(64)
  approvedBy      String?             @map("approved_by") @db.VarChar(256)
  approvedAt      DateTime?           @map("approved_at")
  rejectionReason String?             @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batch     OutreachBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, contactRef])
  @@index([workspaceId, batchId, status])
  @@map("outreach_draft")
}

/// 批次审批（复用 M2.0 语义：超时=拒绝、旧同意不可复用、自审留痕）。
model OutreachBatchApproval {
  id             String                    @id @default(uuid()) @db.Uuid
  workspaceId    String                    @map("workspace_id") @db.Uuid
  batchId        String                    @map("batch_id") @db.Uuid
  contentHash    String                    @map("content_hash") @db.Char(64)
  state          OutreachBatchApprovalState @default(PENDING)
  requestedBy    String                    @map("requested_by") @db.VarChar(256)
  decidedBy      String?                   @map("decided_by") @db.VarChar(256)
  decidedAt      DateTime?                 @map("decided_at")
  decisionReason String?                   @map("decision_reason") @db.VarChar(500)
  expiresAt      DateTime                  @map("expires_at")
  createdAt      DateTime                  @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batch     OutreachBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([workspaceId, state])
  @@index([batchId])
  @@map("outreach_batch_approval")
}

/// 批次审计事件（append-only）：创建/编辑/提交/批准/拒绝/过期/重新打开，供 11-3 审计包使用。
model OutreachBatchEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  batchId     String   @map("batch_id") @db.Uuid
  type        String   @db.VarChar(48)
  actor       String   @db.VarChar(256)
  detail      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batch     OutreachBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([workspaceId, batchId, createdAt])
  @@map("outreach_batch_event")
}

// ─── M2 步 11-3：发送台账与审计包 ───────────────────────────────────────────

enum OutreachSendStatus {
  SENT
  FAILED
  /// DNC/退订命中，未尝试投递；error 字段记录跳过原因。
  SKIPPED
}

/// 发送台账（append-only）：每次发送尝试一行；同一批次/草稿的重试以 attempt 递增。
model OutreachSend {
  id              String             @id @default(uuid()) @db.Uuid
  workspaceId     String             @map("workspace_id") @db.Uuid
  batchId         String             @map("batch_id") @db.Uuid
  draftId         String             @map("draft_id") @db.Uuid
  attempt         Int                @default(1)
  recipientEmail  String             @map("recipient_email") @db.VarChar(320)
  subjectHash     String             @map("subject_hash") @db.Char(64)
  bodyHash        String             @map("body_hash") @db.Char(64)
  mailboxAddress  String             @map("mailbox_address") @db.VarChar(320)
  /// P4-03：本封消耗的授权与序号（SKIPPED 为 null；重试沿用首次消费的序号，不重复计数）。
  authorizationId  String?           @map("authorization_id") @db.Uuid
  authorizationUse Int?              @map("authorization_use")
  messageId       String?            @map("message_id") @db.VarChar(256)
  status          OutreachSendStatus @default(SENT)
  error           String?            @db.VarChar(1000)
  /// P4-04 发送遥测：SMTP 协议层结果与耗时；HARD（5xx 永久拒绝）/ SOFT（4xx、超时、网络）。
  smtpStatusCode  Int?               @map("smtp_status_code")
  smtpResponse    String?            @map("smtp_response") @db.VarChar(500)
  bounceType      String?            @map("bounce_type") @db.VarChar(8)
  latencyMs       Int?               @map("latency_ms")
  sentAt          DateTime?          @map("sent_at")
  createdAt       DateTime           @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batch     OutreachBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, draftId, attempt])
  @@index([workspaceId, batchId, status])
  @@map("outreach_send")
}

// ─── P4-04：发送 job 队列（审批通过入队，worker 认领执行，顺延/重试不烧草稿）─────

enum OutreachSendJobState {
  PENDING
  CLAIMED
  DONE
  FAILED
  CANCELLED
}

/// 发送 job（P4-04）：一封草稿一条；claim_token 做原子认领（等价 SKIP LOCKED 语义）。
/// 幂等键 sha256(batchId|draftId|stepNo) 唯一，重复入队 createMany skipDuplicates 吸收。
model OutreachSendJob {
  id             String               @id @default(uuid()) @db.Uuid
  workspaceId    String               @map("workspace_id") @db.Uuid
  batchId        String               @map("batch_id") @db.Uuid
  draftId        String               @map("draft_id") @db.Uuid
  state          OutreachSendJobState @default(PENDING)
  nextAttemptAt  DateTime             @default(now()) @map("next_attempt_at")
  attempts       Int                  @default(0)
  claimToken     String?              @map("claim_token") @db.Uuid
  claimedAt      DateTime?            @map("claimed_at")
  lastError      String?              @map("last_error") @db.VarChar(1000)
  idempotencyKey String               @unique @map("idempotency_key") @db.VarChar(128)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([state, nextAttemptAt])
  @@index([workspaceId, batchId])
  @@map("outreach_send_job")
}

// ─── P4-05：法审记录与模板版本化（序列/话术/页脚的内容底座）───────────────────

/// 法审记录（占位，等律师书面意见）：模板/话术/同意措辞/合法利益评估的审阅回执。
/// verdict=APPROVED|CONDITIONS|REJECTED；只有 APPROVED 才能被模板版本引用激活（D5-11 发布门）。
model LegalReview {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  /// email_template | phone_script | consent_wording | lia_letter
  subjectKind  String   @map("subject_kind") @db.VarChar(32)
  /// 被审文档内容哈希（与模板 contentHash 同构，激活时必须一致）。
  documentHash String   @map("document_hash") @db.Char(64)
  reviewerName String   @map("reviewer_name") @db.VarChar(200)
  reviewerFirm String   @map("reviewer_firm") @db.VarChar(200)
  reviewedAt   DateTime @map("reviewed_at") @db.Date
  scope        String   @db.VarChar(500)
  verdict      String   @db.VarChar(16)
  conditions   String?
  documentRef  String   @map("document_ref") @db.VarChar(256)
  createdBy    String   @map("created_by") @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([workspaceId, subjectKind])
  @@map("legal_review")
}

/// 模板版本（P4-05）：每次修改=新版本；新版本默认 DRAFT（不生效）；
/// 激活需绑定 APPROVED 且哈希一致的法审记录（LEGAL_REVIEW→APPROVED→ACTIVE→RETIRED）。
model OutreachTemplateVersion {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  /// email_first | email_followup | email_footer | phone_script | consent_wording
  kind          String   @db.VarChar(32)
  /// ISO 3166-1 alpha-2，或 ALL（未限定法域）。
  jurisdiction  String   @default("ALL") @db.VarChar(3)
  language      String   @db.VarChar(8)
  version       Int
  subject       String?  @db.VarChar(300)
  body          String
  contentHash   String   @map("content_hash") @db.Char(64)
  legalReviewId String?  @map("legal_review_id") @db.Uuid
  /// DRAFT | LEGAL_REVIEW | APPROVED | ACTIVE | RETIRED
  state         String   @default("DRAFT") @db.VarChar(16)
  createdBy     String   @map("created_by") @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, kind, jurisdiction, language, version])
  @@index([workspaceId, kind, state])
  @@map("outreach_template_version")
}

// ─── P4-09：实验（holdout/AB）与指标快照 ──────────────────────────────────────

/// 实验：分配盐与策略在创建时冻结，任何人可用同一函数复算分配（ch05 §5.3.7）。
model OutreachExperiment {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  campaignId     String?   @map("campaign_id") @db.Uuid
  name           String    @db.VarChar(200)
  hypothesis     String
  primaryMetric  String    @map("primary_metric") @db.VarChar(64)
  /// holdout | ab
  design         String    @default("holdout") @db.VarChar(16)
  holdoutRatio   Float     @default(0.1) @map("holdout_ratio")
  strata         Json?
  assignmentSalt String    @map("assignment_salt") @db.Char(64)
  analysisPlan   Json?     @map("analysis_plan")
  /// DRAFT | RUNNING | ANALYZED | ARCHIVED
  state          String    @default("DRAFT") @db.VarChar(16)
  startedAt      DateTime? @map("started_at")
  endedAt        DateTime? @map("ended_at")
  createdBy      String    @map("created_by") @db.VarChar(200)
  createdAt      DateTime  @default(now()) @map("created_at")

  assignments OutreachExperimentAssignment[]

  @@index([workspaceId, state])
  @@map("outreach_experiment")
}

/// 确定性分配：bucket = first8bits(sha256(salt|experimentId|subjectRef))；holdout 当 bucket < floor(ratio*256)。
model OutreachExperimentAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  experimentId String   @map("experiment_id") @db.Uuid
  /// account | contact（v1 发送路径按 contact 排除；account 需草稿携带账户引用后启用）
  subjectType  String   @default("account") @map("subject_type") @db.VarChar(16)
  subjectRef   String   @map("subject_ref") @db.Uuid
  /// treatment | holdout
  arm          String   @db.VarChar(8)
  bucket       Int
  assignedAt   DateTime @default(now()) @map("assigned_at")

  experiment OutreachExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, subjectType, subjectRef])
  @@index([experimentId, arm])
  @@map("outreach_experiment_assignment")
}

/// 指标快照（周报只读）：渠道×arm×窗口×指标；口径版本化（definitionVersion）。
model OutreachMetricSnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  experimentId      String?  @map("experiment_id") @db.Uuid
  channel           String   @db.VarChar(16)
  arm               String?  @db.VarChar(8)
  metric            String   @db.VarChar(64)
  numerator         Int
  denominator       Int
  windowStart       DateTime @map("window_start")
  windowEnd         DateTime @map("window_end")
  definitionVersion String   @map("definition_version") @db.VarChar(16)
  laborHours        Float?   @map("labor_hours")
  costMicros        Int?     @map("cost_micros")
  computedAt        DateTime @default(now()) @map("computed_at")

  @@index([workspaceId, channel, windowEnd])
  @@map("outreach_metric_snapshot")
}

// ─── P4-08：健康事件与熔断器持久态 ────────────────────────────────────────────

/// 健康/熔断事件（append-only + 解除留痕）：指标、阈值、动作（WARN/PAUSE/HALT/RECOVER/CLOSE）。
model OutreachHealthEvent {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  /// mailbox | domain | workspace | template
  scope         String    @db.VarChar(16)
  scopeRef      String    @map("scope_ref") @db.VarChar(128)
  metric        String    @db.VarChar(32)
  windowMinutes Int       @map("window_minutes")
  value         Float
  threshold     Float
  action        String    @db.VarChar(16)
  detail        Json?
  detectedAt    DateTime  @default(now()) @map("detected_at")
  resolvedAt    DateTime? @map("resolved_at")
  resolvedBy    String?   @map("resolved_by") @db.VarChar(200)

  @@index([workspaceId, detectedAt])
  @@map("outreach_health_event")
}

/// 熔断器状态机（P4-08）：CLOSED →（评估命中）OPEN →（人工恢复）HALF_OPEN →（小批复核）CLOSED。
model OutreachBreaker {
  workspaceId String    @map("workspace_id") @db.Uuid
  scope       String    @db.VarChar(16)
  scopeRef    String    @map("scope_ref") @db.VarChar(128)
  state       String    @default("CLOSED") @db.VarChar(16)
  reason      String?   @db.VarChar(64)
  detail      Json?
  openedAt    DateTime? @map("opened_at")
  halfOpenAt  DateTime? @map("half_open_at")
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?   @map("resolved_by") @db.VarChar(200)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@id([workspaceId, scope, scopeRef])
  @@map("outreach_breaker")
}

// ─── P4-02/P4-04：发信资产（域名/信箱/配额计数）与 warmup/seed 记录 ─────────────

/// 发信域资产（P4-02）：kind=cold_outbound|catchall_test|transactional；state=WARMING|ACTIVE|PAUSED|RETIRED。
model OutreachDomain {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  domain      String   @db.VarChar(253)
  kind        String   @default("cold_outbound") @db.VarChar(16)
  state       String   @default("WARMING") @db.VarChar(16)
  healthState String   @default("CLOSED") @map("health_state") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")

  mailboxes       OutreachMailbox[]
  domainCounters  OutreachDomainCounter[]
  seedTests       OutreachSeedTest[]

  @@unique([workspaceId, domain])
  @@map("outreach_domain")
}

/// 发件信箱资产（P4-02）：warmupStage=W1|W2|W3|MATURE 决定默认日/周上限；state=ACTIVE|PAUSED|RETIRED。
model OutreachMailbox {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  domainId    String    @map("domain_id") @db.Uuid
  address     String    @db.VarChar(320)
  displayName String    @map("display_name") @db.VarChar(200)
  provider    String    @default("smtp") @db.VarChar(32)
  dailyCap    Int       @default(10) @map("daily_cap")
  weeklyCap   Int       @default(50) @map("weekly_cap")
  warmupStage String    @default("W1") @map("warmup_stage") @db.VarChar(16)
  state       String    @default("ACTIVE") @db.VarChar(16)
  timezone    String    @default("Europe/Berlin") @db.VarChar(64)
  healthState String    @default("CLOSED") @map("health_state") @db.VarChar(16)
  lastSendAt  DateTime? @map("last_send_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  domain   OutreachDomain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  counters OutreachMailboxCounter[]

  @@unique([workspaceId, address])
  @@map("outreach_mailbox")
}

/// 信箱日配额计数（P4-02 落库版；发送成功后原子递增，供日/周上限读取）。
model OutreachMailboxCounter {
  mailboxId   String   @map("mailbox_id") @db.Uuid
  day         DateTime @db.Date
  sent        Int      @default(0)
  hardBounces Int      @default(0) @map("hard_bounces")
  complaints  Int      @default(0)

  mailbox OutreachMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@id([mailboxId, day])
  @@map("outreach_mailbox_counter")
}

/// 发件域 × 收件域的小时计数（P4-02 限速落库版）。
model OutreachDomainCounter {
  domainId        String   @map("domain_id") @db.Uuid
  hour            DateTime
  recipientDomain String   @map("recipient_domain") @db.VarChar(253)
  sent            Int      @default(0)

  domain OutreachDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@id([domainId, hour, recipientDomain])
  @@map("outreach_domain_counter")
}

/// 种子放置测试记录（P4-12 warmup/seed 清单的后端支撑）。
model OutreachSeedTest {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  domainId          String   @map("domain_id") @db.Uuid
  provider          String   @db.VarChar(24)
  testedAt          DateTime @map("tested_at")
  inboxPct          Float?   @map("inbox_pct")
  spamPct           Float?   @map("spam_pct")
  missingPct        Float?   @map("missing_pct")
  gmailInboxPct     Float?   @map("gmail_inbox_pct")
  outlookInboxPct   Float?   @map("outlook_inbox_pct")
  reportRef         String   @map("report_ref") @db.VarChar(256)
  contentHash       String   @map("content_hash") @db.Char(64)
  raw               Json?
  createdAt         DateTime @default(now()) @map("created_at")

  domain OutreachDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, testedAt])
  @@index([workspaceId, testedAt])
  @@map("outreach_seed_test")
}

/// 审计包（不可变）：谁批/何时/发什么/合规依据，packageHash 内容寻址。
model OutreachAuditPackage {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  batchId     String   @map("batch_id") @db.Uuid
  contentHash String   @map("content_hash") @db.Char(64)
  package     Json
  packageHash String   @map("package_hash") @db.Char(64)
  createdBy   String   @map("created_by") @db.VarChar(256)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batch     OutreachBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, packageHash])
  @@index([workspaceId, batchId])
  @@map("outreach_audit_package")
}

// ─── M2 步 11-4：回复/退信/退订回写 ─────────────────────────────────────────

enum OutreachReplyKind {
  REPLY
  BOUNCE
  UNSUBSCRIBE
  /// 投诉（ARF feedback-report 或人工录入），进投诉率熔断。
  COMPLAINT
}

enum OutreachReplyClassification {
  POSITIVE
  NEUTRAL
  NEGATIVE
  OUT_OF_OFFICE
  UNKNOWN
}

/// 入站回复/退信/退订事件（append-only）。任何回复都写入 OPT_OUT 同意，后续批次即停。
/// 幂等：(workspace_id, external_id) 的部分唯一索引（external_id 非空）由迁移
/// 20261109220000_outreach_reply_external_id_unique 管理；Prisma 不支持部分索引，勿加 @@unique。
model OutreachReply {
  id             String                     @id @default(uuid()) @db.Uuid
  workspaceId    String                     @map("workspace_id") @db.Uuid
  contactRef     String                     @map("contact_ref") @db.Uuid
  recipientEmail String?                    @map("recipient_email") @db.VarChar(320)
  kind           OutreachReplyKind          @default(REPLY)
  classification OutreachReplyClassification @default(UNKNOWN)
  subject        String?                    @db.VarChar(300)
  snippet        String?                    @db.VarChar(500)
  externalId     String?                    @map("external_id") @db.VarChar(256)
  receivedAt     DateTime                   @default(now()) @map("received_at")
  createdAt      DateTime                   @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, contactRef, receivedAt])
  @@index([workspaceId, kind, receivedAt])
  @@map("outreach_reply")
}

/// workspace 累计预算/配额（Phase 1b 拒绝钱包攻击）。
/// 签发 Grant 前按滚动窗口检查 run 次数与花费；存量 workspace 迁移 seed 为豁免。
model WorkspaceBudgetPolicy {
  workspaceId    String   @id @map("workspace_id") @db.Uuid
  windowDays     Int      @default(30) @map("window_days")
  maxRuns        Int      @map("max_runs")
  maxSpendMicros BigInt   @map("max_spend_micros")
  enabled        Boolean  @default(true)
  updatedBy      String?  @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_budget_policy")
}

/// D6 per-tenant 合法依据声明（数据处理声明）：每次（重新）声明新增一版，
/// 历史保留用于审计；BFF 在联系人三路由（发现/猜测/验证）自动注入当前版本。
model WorkspaceComplianceDeclaration {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// 自增版本号（每 workspace 从 1 开始），审计按 (workspace, version) 追溯。
  version     Int
  /// legitimate_interest | consent | contract | legal_obligation
  basis       String
  /// LIA/工单/同意记录引用（可审计）。
  ref         String?
  /// 声明正文/评估摘要（最小版表单的自由文本，可承载正式 LIA 全文）。
  note        String?
  declaredBy  String   @map("declared_by") @db.Uuid
  declaredAt  DateTime @default(now()) @map("declared_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, version])
  @@map("workspace_compliance_declaration")
}

/// SaaS 侧对已发起寻源任务的引用。引擎没有“按方案列 run”的端点，
/// 这里只保存 runId 与 plan/ICP 的对应关系，用于关闭页面后找回任务。
model DiscoveryRunLink {
  runId       String   @id @map("run_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  icpId       String   @map("icp_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, planId])
  @@index([workspaceId, icpId])
  @@map("discovery_run_link")
}

/// Run 2.0（M0②）：挖掘任务（任务=挖掘需求，绑定引擎侧 ICP）。任务对象前移到 SaaS，
/// 每次执行产生一条 TaskRun；引擎 run 通过 taskRef 关联回来（引擎 discovery_run.task_ref）。
model AcquisitionTask {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  /// 引擎 ICP id（事实在引擎，这里只存引用）。
  icpId       String?   @map("icp_id") @db.Uuid
  name        String
  /// active | paused | archived
  status      String    @default("active")
  createdBy   String    @map("created_by") @db.Uuid
  lastRunAt   DateTime? @map("last_run_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      TaskRun[]

  @@index([workspaceId, icpId])
  @@map("acquisition_task")
}

/// Run 2.0（M0②）：任务每次执行的记录；status 镜像引擎 run 状态（stats 仍以引擎为准）。
model TaskRun {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  engineRunId String?   @unique @map("engine_run_id") @db.Uuid
  /// manual | schedule
  trigger     String    @default("manual")
  requestedBy String    @map("requested_by") @db.Uuid
  /// RUNNING | DONE | PARTIAL | FAILED | CANCELLED（镜像引擎状态）
  status      String    @default("RUNNING")
  budgetRef   String?   @map("budget_ref")
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  /// P1 attempt 维度（attempt 业务权威在 SaaS）：本次执行对应的查询计划、任务内第 N 次尝试（1 起）、
  /// 前端点击生成的幂等键（同键重放只算一次）、以及「重试自哪一次」（同任务同 plan 的上一 TaskRun）。
  planId      String?   @map("plan_id") @db.Uuid
  attempt     Int       @default(1)
  attemptKey  String?   @map("attempt_key") @db.Uuid
  rerunOf     String?   @map("rerun_of") @db.Uuid

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task       AcquisitionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  rerunOfRun TaskRun?        @relation("TaskRunRerun", fields: [rerunOf], references: [id], onDelete: SetNull)
  reruns     TaskRun[]       @relation("TaskRunRerun")

  @@unique([taskId, attempt])
  @@unique([taskId, attemptKey])
  @@index([workspaceId, taskId, createdAt])
  @@map("task_run")
}

/// (user, workspace) 多对多,SD2:模型必做,UI 只做切换器。
model Membership {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  role        String // admin | member
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
  @@map("membership")
}

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  email       String
  role        String
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@map("invitation")
}

/// 平台运营账号(SD9):独立登录域、独立 cookie,与租户用户物理分表。
model OpsUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("ops_user")
}

/// 会话(可吊销)。realm 区分租户/运营/服务三类登录域。
model Session {
  id          String    @id @default(uuid()) @db.Uuid
  jti         String    @unique
  realm       String // tenant | ops | service | event_consumer
  subjectType String    @map("subject_type") // user | ops_user
  subjectId   String    @map("subject_id")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([subjectId])
  @@map("session")
}

/// worker 事件消费遍历的 workspace 清单(引擎事件按 workspace 隔离,token 必带 claim)。
model WorkspaceRegistry {
  workspaceId String    @id @map("workspace_id") @db.Uuid
  enabled     Boolean   @default(true)
  cursor      String?
  lastPulledAt DateTime? @map("last_pulled_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@map("workspace_registry")
}

/// 事件收件箱。eventId 主键语义上的幂等键;含个人数据(SD5),DSR 级联删除。
model EventInbox {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique @map("event_id")
  workspaceId String    @map("workspace_id") @db.Uuid
  type        String
  payload     Json
  occurredAt  DateTime  @map("occurred_at")
  ackedAt     DateTime? @map("acked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, occurredAt])
  @@map("event_inbox")
}

/// LeadQualified 派生的只读投影(界面列表);可由事件重放重建。
model QualifiedLead {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique @map("event_id")
  workspaceId String   @map("workspace_id") @db.Uuid
  leadId      String   @map("lead_id")
  icpId       String?  @map("icp_id")
  snapshot    Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("qualified_lead")
}

/// 站内通知中心数据源(PRD §14.4)。
model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String?   @map("workspace_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  type        String
  refId       String?   @map("ref_id")
  title       String?
  /// 英文标题（Accept-Language: en 时由 BFF 返回；历史行可为空，回落中文 title）
  titleEn     String?   @map("title_en")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, readAt])
  @@map("notification")
}

/// 控制面 + 运营域白名单写全量审计(A7/E4)。
model AuditLog {
  id      String   @id @default(uuid()) @db.Uuid
  realm   String // tenant | ops | service
  actorId String   @map("actor_id")
  action  String
  target  String?
  detail  Json?
  at      DateTime @default(now())

  @@index([realm, actorId])
  @@index([at])
  @@map("audit_log")
}

/// 周报在线反馈提交记录(SD8 对账)。
model FeedbackSubmission {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  icpId       String   @map("icp_id") @db.Uuid
  isoWeek     String   @map("iso_week")
  rows        Json
  accepted    Int
  rejected    Int
  skipped     Int
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("feedback_submission")
}

/// DSR 转发记录:引擎 deletion_request 与 SaaS 侧级联删除的对账(A6/SD5)。
model DeletionMirror {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String?  @map("workspace_id") @db.Uuid
  engineRequestId String  @unique @map("engine_request_id")
  status         String
  saasDeleted    Int      @default(0) @map("saas_deleted")
  at             DateTime @default(now())

  @@map("deletion_mirror")
}

/// 成本类事件归集(SD3):为二期 billing 归因积累数据。
model CostLedger {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  sourceEventId String?  @map("source_event_id")
  amountMicros  Int      @map("amount_micros")
  occurredAt    DateTime @map("occurred_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, sourceEventId], map: "cost_ledger_workspace_id_source_event_id_key")
  @@index([workspaceId])
  @@map("cost_ledger")
}

/// 引擎 JWT 签名钥元数据(私钥在 env/文件,双钥重叠轮换,PRD §2.3)。
model SigningKey {
  kid       String   @id
  algorithm String
  status    String // active | previous
  createdAt DateTime @default(now()) @map("created_at")

  @@map("signing_key")
}

/// 内嵌模型网关的上游厂商(运营台配置)。API Key 只存 AES-256-GCM 密文。
model AiProvider {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  baseUrl      String   @map("base_url")
  apiKeyCipher String   @map("api_key_cipher")
  headers      Json? // 额外请求头(如 OpenRouter 的 HTTP-Referer)
  enabled      Boolean  @default(true)
  priority     Int      @default(100)
  timeoutMs    Int      @default(120000) @map("timeout_ms")
  /// 推理模型会把 reasoning token 算进输出上限;设置下限避免引擎的 8192 预算被推理耗尽
  minOutputTokens Int?  @map("min_output_tokens")
  /// 兼容新式 OpenAI 推理模型:max_tokens | max_completion_tokens
  maxTokensField String @default("max_tokens") @map("max_tokens_field")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  routes AiModelRoute[]
  calls  ModelCallLog[]

  @@map("ai_provider")
}

/// 公开模型别名(引擎请求的 model)→ 上游厂商 + 上游真实模型。
/// 同一别名可配多个厂商做优先级回退;没有别名命中时走 isDefault 路由。
model AiModelRoute {
  id            String   @id @default(uuid()) @db.Uuid
  providerId    String   @map("provider_id") @db.Uuid
  alias         String
  upstreamModel String   @map("upstream_model")
  enabled       Boolean  @default(true)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([alias, providerId])
  @@index([alias])
  @@map("ai_model_route")
}

/// 网关调用元数据(不存 prompt/补全,避免个人数据进日志)。
model ModelCallLog {
  id            String   @id @default(uuid()) @db.Uuid
  requestId     String   @map("request_id")
  providerId    String?  @map("provider_id") @db.Uuid
  alias         String
  upstreamModel String   @map("upstream_model")
  status        String // OK | ERROR
  httpStatus    Int?     @map("http_status")
  latencyMs     Int      @map("latency_ms")
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  error         String?
  at            DateTime @default(now())

  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([at])
  @@map("model_call_log")
}

/// R4 平台权威的撤销消费者租约(P6)。语义与 GrowthOS 的同名表一致:
/// 只有 state=ACTIVE 且心跳新鲜(≤30 秒)才允许签发 capability。
model R4ConsumerLease {
  scheduleId           String    @id @map("schedule_id")
  componentKind        String    @default("REVOCATION_CONSUMER") @map("component_kind")
  generation           BigInt    @default(0)
  ownershipGeneration  BigInt?   @map("ownership_generation")
  state                String    @default("RELEASED")
  lastSeenAt           DateTime? @map("last_seen_at")
  expiresAt            DateTime? @map("expires_at")
  lastTickAt           DateTime? @map("last_tick_at")
  lastDispatchedAt     DateTime  @default(dbgenerated("'epoch'")) @map("last_dispatched_at")
  nextTickAt           DateTime  @default(dbgenerated("'epoch'")) @map("next_tick_at")

  @@map("r4_consumer_lease")
}

/// 待投递的撤销(P6)。capability 的积压事实由此计算:有 PENDING 且最老一条超过
/// 30 秒就不能签发能力。
model R4RevocationOutbox {
  id          String    @id @default(uuid()) @db.Uuid
  scheduleId  String    @map("schedule_id")
  commandJws  String    @map("command_jws")
  state       String    @default("PENDING")
  createdAt   DateTime  @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")
  ackedAt     DateTime? @map("acked_at")
  lastError   String?   @map("last_error")

  @@index([state, createdAt])
  @@map("r4_revocation_outbox")
}

/// egress 策略安装审计(P3d)。generation 只前进,每次真实安装追加一行。
model R4EgressInstallAudit {
  id                       String   @id @default(uuid()) @db.Uuid
  scheduleId               String   @map("schedule_id")
  fromGeneration           BigInt   @map("from_generation")
  toGeneration             BigInt   @map("to_generation")
  policyArtifactSha256     String   @map("policy_artifact_sha256")
  executionEnvelopeSha256  String   @map("execution_envelope_sha256")
  requiredCapMicrousd      BigInt   @map("required_cap_microusd")
  quotePolicyRevision      String   @map("quote_policy_revision")
  operator                 String
  at                       DateTime @default(now())

  @@map("r4_egress_install_audit")
}

/// 平台运行 Grant 签发记录(P7 后的平台准入 v2)。权威方先落库再给字节:
/// 同一 workflow_run_id 只有一张 Grant,引擎的重试拿回同一张 JWS。
model R4PlatformGrant {
  jti                     String   @id @db.Uuid
  purpose                 String
  scheduleId              String   @map("schedule_id")
  workflowId              String   @map("workflow_id")
  workflowRunId           String   @unique @map("workflow_run_id") @db.Uuid
  scheduleRequestSha256   String   @map("schedule_request_sha256")
  technicalPolicyRevision String   @map("technical_policy_revision")
  capPerRunMicrousd       BigInt   @map("cap_per_run_microusd")
  campaignCapMicrousd     BigInt   @map("campaign_cap_microusd")
  maxRuns                 BigInt   @map("max_runs")
  issuedAt                DateTime @map("issued_at")
  expiresAt               DateTime @map("expires_at")
  token                   String
  tokenSha256             String   @map("token_sha256")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([scheduleId, createdAt])
  @@map("r4_platform_grant")
}

/// 平台渠道抓取 Grant（P4-P3）：一张 Grant 绑定一个 channel-crawl 运行。
/// replay 以 crawl_run_id 唯一；按渠道日页数配额对账读 (channel_id, issued_at)。
model R4ChannelCrawlGrant {
  jti                     String   @id @db.Uuid
  purpose                 String
  channelId               String   @map("channel_id") @db.Uuid
  mode                    String
  pageCap                 BigInt   @map("page_cap")
  crawlRunId              String   @unique @map("crawl_run_id") @db.Uuid
  requestSha256           String   @map("request_sha256")
  technicalPolicyRevision String   @map("technical_policy_revision")
  capPerRunMicrousd       BigInt   @map("cap_per_run_microusd")
  campaignCapMicrousd     BigInt   @map("campaign_cap_microusd")
  maxRuns                 BigInt   @map("max_runs")
  issuedAt                DateTime @map("issued_at")
  expiresAt               DateTime @map("expires_at")
  token                   String
  tokenSha256             String   @map("token_sha256")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([channelId, issuedAt])
  @@map("r4_channel_crawl_grant")
}

/// 平台撤销的**逻辑请求**(P9 自动触发)。一个请求 = 一次「关闭某个 schedule」的意图;
/// 可能有多次追加式尝试(attempt),但 fence_sequence 在请求创建时一次分配、不再变。
/// state 语义:
///  - PENDING_CONFIRMATION: 自动来源(政策停用/绑定撤销)在受审计重开路径就绪前等待操作员确认
///  - PENDING: 待投递或投递中(delivery_unknown=true 表示至少一次结果未知,仍以原字节重试)
///  - ACKED / NO_LIVE_TARGET / BLOCKED / STORED_STATE_CONFLICT / CANCELLED: 终态
/// CANCELLED 只允许从 PENDING_CONFIRMATION(从未投递)或 BLOCKED/STORED_STATE_CONFLICT(确定性未提交)
/// 进入,绝不允许从 PENDING(可能已提交)取消。
model R4RevocationRequest {
  id                  String    @id @default(uuid()) @db.Uuid
  scheduleId          String    @map("schedule_id")
  reasonCode          String    @map("reason_code")
  source              String
  requestedBy         String    @map("requested_by")
  note                String?
  dedupeKey           String?   @unique @map("dedupe_key")
  state               String    @default("PENDING")
  deliveryUnknown     Boolean   @default(false) @map("delivery_unknown")
  fenceSequence       BigInt    @map("fence_sequence")
  confirmedBy         String?   @map("confirmed_by")
  confirmedAt         DateTime? @map("confirmed_at")
  nextAttemptAt       DateTime? @map("next_attempt_at")
  attemptCount        Int       @default(0) @map("attempt_count")
  ackReceiptId        String?   @map("ack_receipt_id") @db.Uuid
  ackGeneration       BigInt?   @map("ack_generation")
  ackCommittedAt      DateTime? @map("ack_committed_at")
  ackInFlightAttempts BigInt?   @map("ack_in_flight_attempts")
  ackSha256           String?   @map("ack_sha256")
  lastError           String?   @map("last_error")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  attempts            R4RevocationAttempt[]

  @@unique([scheduleId, fenceSequence], map: "r4_revocation_request_schedule_sequence_key")
  @@index([state, nextAttemptAt], map: "r4_revocation_request_state_next_attempt_idx")
  @@index([scheduleId, createdAt], map: "r4_revocation_request_schedule_created_idx")
  @@map("r4_revocation_request")
}

/// 追加式投递尝试(P9)。每次签名都落库:command_jws 用于**原字节重放**,
/// 结果只能由后端确定性响应或已验签 ACK 推进,缺 ACK 一律保持未决。
model R4RevocationAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  requestId     String   @map("request_id") @db.Uuid
  ordinal       Int
  commandJws    String   @map("command_jws")
  commandSha256 String   @map("command_sha256")
  revocationJti String   @unique @map("revocation_jti") @db.Uuid
  targetIssuer  String   @map("target_issuer")
  targetJti     String   @map("target_jti") @db.Uuid
  workflowRunId String   @map("workflow_run_id") @db.Uuid
  fenceSequence BigInt   @map("fence_sequence")
  issuedAt      DateTime @map("issued_at")
  expiresAt     DateTime @map("expires_at")
  outcome       String?
  httpStatus    Int?     @map("http_status")
  errorCode     String?  @map("error_code")
  ackSha256     String?  @map("ack_sha256")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  request       R4RevocationRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "r4_revocation_attempt_request_fkey")

  @@unique([requestId, ordinal], map: "r4_revocation_attempt_request_ordinal_key")
  @@map("r4_revocation_attempt")
}

/// 平台策略状态的持久镜像(P9)。配置(R4_PLATFORM_POLICY_MODES)是期望值:
/// 首次见到某个 schedule 只建立基线;ENABLED→DISABLED 才产生撤销请求;
/// DISABLED→ENABLED 只记录,不重开围栏(重开是后端的受审计路径)。
model R4PlatformPolicyState {
  scheduleId String   @id @map("schedule_id")
  mode       String   @default("ENABLED")
  revision   String?
  updatedBy  String   @map("updated_by")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("r4_platform_policy_state")
}

/// 每 schedule 的撤销序列号计数器(P9)。fence_sequence 必须严格大于后端当前值,
/// 由权威方持久分配;请求创建时取走一个号,未决请求也占用自己的号。
model R4RevocationSequence {
  scheduleId String @id @map("schedule_id")
  nextValue  BigInt @default(1) @map("next_value")

  @@map("r4_revocation_sequence")
}

/// 登录/注册/接受邀请的持久化限流计数(替代单进程内存 Map)。
/// key 形如 "tenant-login:<ip>:<email>";窗口从首次尝试固定,成功后清除。
model AuthThrottle {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime @map("reset_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resetAt], map: "auth_throttle_reset_at_idx")
  @@map("auth_throttle")
}

// ─── M2 步 10：QGO / SAO / Opportunity Outcome（docs/superpowers/plans/2026-11-08-qgo-domain-m2-step10.md）───
// SoR 在本仓（Growth Core）；lead_ref/canonical_company_ref/icp_ref 是引擎对象引用（不做跨库外键）。
// 与引擎的关系：候选/线索=引擎（CandidateBatchCompleted/LeadQualified 事件），提升证据来自引擎快照。

/// 商机（Qualified Growth Opportunity）：合格的线索 + 需求/时机证据 + 合法下一步。
/// 同一 lead 重复提升幂等（workspace_id, lead_ref 唯一）。证据只存 URL/时间/摘要，不存联系人 PII。
model Qgo {
  id                  String   @id @default(uuid()) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  leadRef             String   @map("lead_ref") @db.Uuid
  canonicalCompanyRef String   @map("canonical_company_ref") @db.Uuid
  icpRef              String?  @map("icp_ref") @db.Uuid
  campaignId          String?  @map("campaign_id") @db.Uuid
  title               String
  score               Float?
  evidence            Json
  nextStep            String   @map("next_step")
  /// OPEN → CONVERTED（SAO 接受）/ DROPPED（拒绝）。
  state               String   @default("OPEN")
  createdBy           String   @map("created_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sao       Sao?

  @@unique([workspaceId, leadRef], map: "qgo_workspace_id_lead_ref_key")
  @@index([workspaceId, state], map: "qgo_workspace_id_state_idx")
  @@map("qgo")
}

/// 销售接受（Sales Accepted Opportunity）：对 QGO 的人工决定（接受/拒绝），一 QGO 一行。
model Sao {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// 一 QGO 一 SAO：qgo_id 全局唯一（uuid），Prisma 1:1 关系的定义侧要求单列唯一。
  qgoId       String   @unique @map("qgo_id") @db.Uuid
  /// ACCEPTED | DECLINED。
  state       String
  decidedBy   String   @map("decided_by") @db.Uuid
  decidedAt   DateTime @map("decided_at")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  qgo       Qgo       @relation(fields: [qgoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  outcomes  OpportunityOutcome[]

  @@unique([workspaceId, qgoId], map: "sao_workspace_id_qgo_id_key")
  @@index([workspaceId, state], map: "sao_workspace_id_state_idx")
  @@map("sao")
}

/// 商机结果（append-only 事件序列）：回复/会议/报价/赢单/丢单/无响应/不合格。
/// 人工登记（MANUAL）可重复；未来系统回写（SYSTEM）按 (sao_id, source_event_id) 幂等。
model OpportunityOutcome {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  saoId         String   @map("sao_id") @db.Uuid
  /// REPLIED | MEETING_BOOKED | QUOTE_SENT | WON | LOST | NO_RESPONSE | DISQUALIFIED。
  outcome       String
  occurredAt    DateTime @map("occurred_at")
  /// SYSTEM | MANUAL。
  source        String
  evidenceRef   String?  @map("evidence_ref")
  note          String?
  sourceEventId String?  @map("source_event_id")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sao       Sao       @relation(fields: [saoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([saoId, sourceEventId], map: "opportunity_outcome_sao_id_source_event_id_key")
  @@index([workspaceId, occurredAt], map: "opportunity_outcome_workspace_id_occurred_at_idx")
  @@map("opportunity_outcome")
}

/// 幂等键记录（P5b-05）：BFF 变更请求携带 Idempotency-Key 时，同一(租户,路由,键)
/// 只执行一次；重放返回首次响应。TTL 24h（expiresAt 到期后由维护任务清理，
/// 到期前同一键重放仍返回原响应）。
model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  /// 归一化路由标识："POST /api/v1/companies/:id/accept" 形态的 scope。
  scope          String
  key            String
  /// sha256(规范化请求体)；同键不同体 = 误用，返回 409。
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@unique([workspaceId, scope, key], map: "idempotency_record_workspace_id_scope_key_key")
  @@index([expiresAt], map: "idempotency_record_expires_at_idx")
  @@map("idempotency_record")
}
