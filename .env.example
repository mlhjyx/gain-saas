# gain-saas 环境配置(复制为 .env 并填写;密钥不入仓)
NODE_ENV=development
HOST=127.0.0.1
PORT=4020

# SaaS 自有库(独立容器,见 deploy/compose.postgres.yml)
DATABASE_URL=postgresql://gain_saas:CHANGE_ME@127.0.0.1:5433/gain_saas

# 引擎(global/backend)
ENGINE_ORIGIN=http://127.0.0.1:3000
ENGINE_OPENAPI_URL=http://127.0.0.1:3000/api/docs-json
TEMPORAL_ADDRESS=127.0.0.1:7233

# SaaS 自有会话签名(HS256):openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_MINUTES=60

# 引擎 JWT 签名钥(RS256):PEM 私钥全文(\n 转义)+ kid
# 首次生成:openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
ENGINE_JWT_PRIVATE_KEY=
ENGINE_JWT_KEY_ID=saas-2026-10-01
# 必须与引擎 AUTH_ISSUER 完全一致;引擎只接受 https,本机由 deploy/systemd/gain-saas-jwks-tls
# 在 127.0.0.1:18446 提供 TLS 回环端点(证书来自 r4-pki 的 gain-saas-jwks 叶子)
ENGINE_JWT_ISSUER=https://127.0.0.1:18446
ENGINE_JWT_AUDIENCE=global-backend

# 执行预算 Grant 签名钥(RS256,必须与上面的身份钥分离)
# 首次生成:openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits=2048
# 引擎侧对应配置:
#   EXECUTION_BUDGET_GRANT_JWKS_URI=https://127.0.0.1:18446/.well-known/execution-budget-jwks.json
#   EXECUTION_BUDGET_GRANT_ISSUER=https://127.0.0.1:18446/execution-budget
#   EXECUTION_BUDGET_GRANT_AUDIENCE=global-backend:execution-budget
#   EXECUTION_BUDGET_GRANT_ALGORITHMS=RS256
ENGINE_BUDGET_GRANT_PRIVATE_KEY=
ENGINE_BUDGET_GRANT_KEY_ID=budget-2026-10-01
ENGINE_BUDGET_GRANT_ISSUER=https://127.0.0.1:18446/execution-budget
ENGINE_BUDGET_GRANT_TTL_SECONDS=240
# 引擎联系人发现 attemptId（引擎镜像需含 discover attemptId 支持）。默认 false：
# BFF 会把前端发送的 attemptId 从 quote 与转发体中剥离，兼容旧引擎。
# 引擎镜像升级后再设为 true，重复点击「发现联系人」才会各用独立预算账户。
ENGINE_DISCOVER_ATTEMPT_ID_ENABLED=false
# P1 重试 attempt 维度（引擎 #791/B1 起支持）：与 ENGINE_DISCOVER_ATTEMPT_ID_ENABLED 等价——
# 任一为 true 即视为引擎支持 attemptId 并透传；两个都关时 BFF 从 quote/转发体剥离（兼容旧引擎）。
ENGINE_RETRY_ATTEMPT_ID_ENABLED=false

# SD6:design partner 阶段的注册邀请码;不配置 = 不校验(开发期)
INVITE_CODE=

# 事件消费(SD4):引擎侧 saas-event-consumer 角色映射配置就绪后置 true
EVENT_CONSUMER_ENABLED=false
EVENT_CONSUMER_INTERVAL_MS=120000
EVENT_CONSUMER_PAGE_LIMIT=100
# workspace 累计预算/配额（Phase 1b）：滚动窗口内 run 次数与花费上限（microUSD）。
# 存量 workspace 由迁移豁免（enabled=false）；新 workspace 按以下默认懒创建。
WORKSPACE_QUOTA_ENFORCE=true
WORKSPACE_QUOTA_WINDOW_DAYS=30
WORKSPACE_QUOTA_MAX_RUNS=30
WORKSPACE_QUOTA_MAX_SPEND_MICROS=15000000

# 运营域(SD9):引擎库 app/owner 连接串,来自引擎 packages/db/.env;不配置则运营域 503
OPS_APP_DATABASE_URL=
OPS_OWNER_DATABASE_URL=
# 运营会话 TTL(独立 cookie/独立 realm;与租户会话互不可调)
OPS_SESSION_TTL_MINUTES=480
# 存量回填(pnpm bootstrap:backfill)必须用能看穿 outbox_event RLS 的连接:
# OPS_BACKFILL_DATABASE_URL(或 ENGINE_DATABASE_URL)指向引擎 owner / 带 BYPASSRLS 的只读角色;
# 用 app_user(OPS_APP_DATABASE_URL)会静默读到 0 行。
OPS_BACKFILL_DATABASE_URL=

# 内嵌模型网关(运营台「模型网关」页配置上游厂商;引擎改指向 /v1):
# MODEL_GATEWAY_API_KEY=openssl rand -hex 32
# MODEL_GATEWAY_ENC_KEY=openssl rand -hex 32(上游 API Key 落库加密;轮换后需重录)
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_ENC_KEY=

# 前端产物目录(相对 apps/server)
SPA_DIST_DIR=../web/dist
