{
  "name": "gain-saas",
  "version": "0.1.0",
  "private": true,
  "description": "海外增长机会操作系统 SaaS 平台(模块 01-04 + 平台运营域),对接 global/backend 获客引擎",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  },
  "scripts": {
    "postinstall": "pnpm -r run --if-present stub",
    "dev:web": "pnpm --filter @vben/web-antd dev",
    "dev:server": "pnpm --filter @gain-saas/server dev",
    "build": "pnpm --filter @gain-saas/shared --filter @gain-saas/ops-pg --filter @gain-saas/server --filter @vben/web-antd run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "gen:engine": "pnpm --filter @gain-saas/engine-client gen",
    "bootstrap:operator": "pnpm --filter @gain-saas/server bootstrap:operator",
    "bootstrap:backfill": "pnpm --filter @gain-saas/server bootstrap:backfill",
    "db:migrate": "pnpm --filter @gain-saas/server db:migrate",
    "db:generate": "pnpm --filter @gain-saas/server db:generate"
  }
}
